# Copy to .env.local and fill in. Never commit .env.local.

# ── Database: Supabase Postgres ─────────────────────────────────────────────
# Supabase dashboard → Connect → ORMs / Connection string.
# Pooled (transaction mode, port 6543) for the app at runtime:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / session connection (port 5432) for migrations and seeding:
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Connections per server process (optional). Keep small on serverless.
# DATABASE_POOL_MAX=5

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Rate limits are on in production; "off" disables them (end-to-end tests).
# AUTH_RATE_LIMIT=off

# ── Demo mode ───────────────────────────────────────────────────────────────
# One-click demo logins, and the reset screen shows the emailed link.
# Set to "false" for any real deployment.
DEMO_MODE="true"
DEMO_PASSWORD="grove-demo-2026"

# Where uploaded documents are stored (local disk). Defaults to .uploads/ in the project.
# UPLOAD_DIR=".uploads"

# ── Hosted file storage (production) ────────────────────────────────────────
# Supabase dashboard → Project Settings → API. The service-role key is a
# server-only secret: never prefix it with NEXT_PUBLIC_, never commit it.
# When both are set, documents go to a private bucket instead of UPLOAD_DIR.
# Vercel requires them (its filesystem is read-only).
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="documents"

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret for /api/cron/*. Vercel Cron sends it as a bearer token.
# At least 16 characters. Without it the reminders job refuses to run.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=""
